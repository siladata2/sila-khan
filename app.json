{
  "name": "𝚃𝚈𝚁𝙴𝚇-𝙺𝚂𝙷-𝙼𝙳",
  "description": "𝚃𝚈𝚁𝙴𝚇-𝙺𝚂𝙷-𝙼𝙳 WhatsApp bot by Ƭყɾҽx-ƙʂԋ-Ƭҽƈԋ",
  "logo": "https://raw.githubusercontent.com/siladata2/Tyrex-bot/refs/heads/main/tyrex/tyrex.jpeg",
  "keywords": [
    "whatsapp",
    "bot",
    "tyrex-ksh-md",
    "baileys",
    "session"
  ],
  "repository": "https://github.com/siladata2/Tyrex-bot",
  "scripts": {
    "start": "node --no-warnings --expose-gc --max-old-space-size=1024 --experimental-global-webcrypto index.js"
  },
  "env": {
    "SESSION_ID": {
      "description": "REQUIRED: Your WhatsApp session ID.",
      "value": "",
      "required": true
    },
    "DATABASE_URL": {
      "description": "OPTIONAL: PostgreSQL connection string. Leave blank to use SQLite.",
      "value": "",
      "required": false
    },
    "PTERODACTYL_KEY": {
      "description": "OPTIONAL: Your Pterodactyl Application API key.",
      "value": "",
      "required": false
    },
    "PTERODACTYL_URL": {
      "description": "OPTIONAL: Your Pterodactyl panel URL.",
      "value": "",
      "required": false
    },
    "PAYSTACK_KEY": {
      "description": "OPTIONAL: Your Paystack secret key.",
      "value": "",
      "required": false
    },
    "BOT_PREFIX": {
      "description": "OPTIONAL: Command prefix. Defaults to '.'.",
      "value": ".",
      "required": false
    },
    "BOT_MODE": {
      "description": "OPTIONAL: Bot operating mode.",
      "value": "public",
      "required": false
    },
    "BOT_NAME": {
      "description": "OPTIONAL: Display name for the bot.",
      "value": "𝚃𝚈𝚁𝙴𝚇-𝙺𝚂𝙷-𝙼𝙳",
      "required": false
    },
    "BOT_TIMEZONE": {
      "description": "OPTIONAL: Timezone used by the bot.",
      "value": "Africa/Dar_es_Salaam",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "OPTIONAL: Owner WhatsApp number without +.",
      "value": "255610744352",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    },
    {
      "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git"
    }
  ]
}